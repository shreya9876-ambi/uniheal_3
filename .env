# UniHeal MongoDB Configuration
# Replace the URI below with your MongoDB Atlas connection string or local MongoDB URI
MONGODB_URI=mongodb://127.0.0.1:27017/uniheal

# Backend Server Configuration
PORT=5000
JWT_SECRET=uniheal_jwt_secure_key_2025

# Frontend API Endpoint
VITE_API_URL=http://localhost:5000/api

# Default Administrator Account (auto-created on first database connection)
DEFAULT_ADMIN_EMAIL=admin@uniheal.edu
DEFAULT_ADMIN_PASSWORD=admin123
